{
	"name": "cms-playground",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vue-tsc -b && vite build && pnpm build:ssr",
		"build:ssr": "vite build --ssr src/entry-server.ts --outDir dist-ssr",
		"render-server": "node node_modules/@trainpaths/cms/server/render-server.js",
		"preview": "vite preview",
		"typecheck": "vue-tsc -b",
		"test:e2e": "playwright test --config=e2e/playwright.config.ts",
		"test:e2e:ui": "playwright test --config=e2e/playwright.config.ts --ui",
		"test:e2e:debug": "playwright test --config=e2e/playwright.config.ts --debug",
		"dev:demo": "vite --config vite.demo.config.ts",
		"build:demo": "vite build --config vite.demo.config.ts",
		"preview:demo": "vite preview --config vite.demo.config.ts",
		"test:demo": "vitest run --config demo/vitest.config.ts"
	},
	"dependencies": {
		"@trainpaths/cms": "workspace:*",
		"@trainpaths/nb-ui": "github:trainpaths/nb-ui#v1.4.0",
		"pinia": "^4.1.0",
		"vue": "^3.5.44",
		"vue-router": "^5.4.0"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.1",
		"@types/node": "^26.6.6",
		"tailwindcss": "^4.3.4",
		"typescript": "~6.0.3",
		"vite": "^8.3.5",
		"vitest": "^5.1.0",
		"vue-tsc": "^3.3.14"
	}
}
