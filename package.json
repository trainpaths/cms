	},
	"devDependencies": {
		"@vue/eslint-config-typescript": "^14.9.0",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-vue": "^10.11.1",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.71.0"
	}
}
