{
	"name": "cms",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.6.0",
	"scripts": {
		"dev": "pnpm --filter cms-playground dev",
		"build": "pnpm --filter cms-playground build",
		"typecheck": "pnpm -r typecheck",
		"lint": "eslint .",
		"test": "pnpm --filter @trainpaths/cms test",
