# Host port mappings (docker-compose only)
API_PORT=5183
FRONTEND_PORT=5173

# Postgres
DB_NAME=app
DB_USER=app
DB_PASSWORD=change-me

# api
ASPNETCORE_ENVIRONMENT=Production
CORS_ORIGINS=http://localhost:5173
# JWT / security — required; generate with: openssl rand -base64 48
API_JWT_KEY=
API_JWT_ISSUER=website-template
API_JWT_AUDIENCE=website-template-clients
API_JWT_ACCESS_MINUTES=15
API_JWT_REFRESH_DAYS=30
# Per-IP limits. Credential/email endpoints:
RATE_LIMIT_PERMIT=10
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_QUEUE=0
# Session endpoints (refresh, logout, me, profile):
RATE_LIMIT_GENERAL_PERMIT=120
RATE_LIMIT_GENERAL_WINDOW_SECONDS=60
# Page editor (autosaves) and public page reads
RATE_LIMIT_PAGES_PERMIT=600
RATE_LIMIT_PAGES_WINDOW_SECONDS=60
# Proxies allowed to set X-Forwarded-For (CIDRs, comma-separated)
FORWARDED_KNOWN_NETWORKS=172.16.0.0/12
# Set to false only when serving over plain HTTP on a host other than localhost.
AUTH_SECURE_COOKIE=true
# Creates the first super_admin staff account on startup (password >= 12 chars); clear afterwards.
BOOTSTRAP_SUPERADMIN_EMAIL=
BOOTSTRAP_SUPERADMIN_PASSWORD=
# Email / SMTP (leave SMTP_HOST empty to use the console sender — links are logged by the API).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@example.com
EMAIL_FROM_NAME=WebsiteTemplate
# Frontend origin used to build verification / reset links in emails (no trailing slash).
APP_BASE_URL=http://localhost:${FRONTEND_PORT}

# Media blob storage (SeaweedFS S3, internal to the compose network) — required.
# Credentials are created from these on first start; generate with: openssl rand -hex 32
S3_ACCESS_KEY=cms
S3_SECRET_KEY=
S3_BUCKET=media

# Frontend (vite dev only) — target of the Vite /api proxy
VITE_API_BASE_URL=http://localhost:${API_PORT}
