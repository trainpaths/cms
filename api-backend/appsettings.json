{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient.IRendererClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "website-template",
    "Audience": "website-template-clients",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Cors": {
    "Origins": "http://localhost:5173"
  },
  "ForwardedHeaders": {
    "KnownNetworks": ""
  },
  "RateLimiting": {
    "PermitLimit": 10,
    "WindowSeconds": 60,
    "QueueLimit": 0,
    "General": {
      "PermitLimit": 120,
      "WindowSeconds": 60
    },
    "Pages": {
      "PermitLimit": 600,
      "WindowSeconds": 60
    }
  },
  "Storage": {
    "S3": {
      "ServiceUrl": "",
      "AccessKey": "",
      "SecretKey": "",
      "Bucket": "media",
      "Region": "us-east-1"
    }
  },
  "Bootstrap": {
    "SuperAdminEmail": "",
    "SuperAdminPassword": "",
    "DefaultPages": true
  },
  "Email": {
    "Host": "",
    "Port": 587,
    "User": "",
    "Password": "",
    "From": "no-reply@example.com",
    "FromName": "Website Template",
    "LinkBaseUrl": "http://localhost:5173",
    "VerificationLinkExpiryHours": 24,
    "ResetLinkExpiryHours": 1
  }
}
