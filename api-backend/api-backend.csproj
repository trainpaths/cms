<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>api_backend</RootNamespace>
    <UserSecretsId>3decac81-416f-4a1e-8e84-33adb30fd620</UserSecretsId>
    <!-- swagger.json emitted on every build; Docker build overrides to /spec. -->
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/../frontend/openapi</OpenApiDocumentsDirectory>
    <!-- Tests/ nested here; exclude so its bin/obj aren't picked up. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Tests/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.18.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <!-- Keep same version as ApiDescription.Server. -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.23.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="10.3.0" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.0" />
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />
    <PackageReference Include="AWSSDK.S3" Version="4.0.104.2" />
  </ItemGroup>

  <!-- Generator emits api-backend.json; rename to swagger.json. -->
  <Target Name="NormalizeOpenApiFileName" AfterTargets="GenerateOpenApiDocuments">
    <ItemGroup>
      <_GeneratedOpenApi Include="$(OpenApiDocumentsDirectory)/*.json" Exclude="$(OpenApiDocumentsDirectory)/swagger.json" />
    </ItemGroup>
    <Move SourceFiles="@(_GeneratedOpenApi)" DestinationFiles="$(OpenApiDocumentsDirectory)/swagger.json" Condition="'@(_GeneratedOpenApi)' != ''" />
  </Target>
</Project>
